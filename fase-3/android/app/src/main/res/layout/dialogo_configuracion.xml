<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/estadoJdkDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_campo"
        android:padding="12dp"
        android:text="@string/estado_jdk_consultando"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/cajaJdk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/dialogo_jdk_ruta">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campoJdk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="12sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dialogo_jdk_ruta_ayuda"
        android:textColor="@color/texto_tenue"
        android:textSize="10sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/cajaApi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/dialogo_api_url">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/campoApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="12sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dialogo_api_url_ayuda"
        android:textColor="@color/texto_tenue"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/mensajeDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/error"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
