<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAyuda"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primario"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_atras"
        app:navigationIconTint="@color/blanco"
        app:subtitle="@string/ayuda_subtitulo"
        app:subtitleTextColor="#C7CCF5"
        app:title="@string/ayuda_titulo"
        app:titleTextColor="@color/blanco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/contenidoAyuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/texto_secundario"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:elevation="6dp"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCerrarAyuda"
            style="@style/BotonAccion"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/cerrar"
            android:textColor="@color/blanco"
            app:backgroundTint="@color/primario"
            app:icon="@drawable/ic_cerrar"
            app:iconTint="@color/blanco" />
    </LinearLayout>
</LinearLayout>
