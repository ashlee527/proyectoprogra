<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite HTTP sin cifrar para desarrollo local (emulador 10.0.2.2 o IP de la red). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
